# Rust
/target/
**/*.rs.bk
# Cargo.lock is intentionally committed for a binary application.

# Build artifacts
/dist/
/build/
*.pdb

# Environment and secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials.json

# Node / frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
.nuxt/
.vite/

# IDE and editors
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs and local data
*.log
*.tmp
/tmp/
data/
uploads/
