{{!-- Events list view (module:events/list).
  Renders `items` (array of event records) with an
  optional `pagination` object. Each row may carry `detail_url` (linked
  from the first column) and `status_class` (badge modifier, for
  example `badge-success`). --}}
<section class="admin-section section-panel" data-section="events" aria-labelledby="events-list-heading">
  <h1 id="events-list-heading">{{#if title}}{{title}}{{else}}Events{{/if}}</h1>
  <p class="page-intro">Events with venues, schedules, and categories.</p>
  {{#if is_admin_user}}
  {{#if create_url}}
  <p><a class="button" href="{{create_url}}">New event</a></p>
  {{/if}}
  {{/if}}
  {{#if items}}
  <table class="table">
    <thead>
      <tr>
        <th scope="col">Title</th>
        <th scope="col">Slug</th>
        <th scope="col">Categories</th>
        <th scope="col">Starts</th>
        <th scope="col">Ends</th>
        <th scope="col">Timezone</th>
      </tr>
    </thead>
    <tbody>
      {{#each items}}
      <tr>
        <td>{{#if detail_url}}<a href="{{detail_url}}">{{title}}</a>{{else}}{{title}}{{/if}}</td>
        <td>{{slug}}</td>
        <td>{{#each category}}{{#unless @first}}, {{/unless}}{{this}}{{/each}}</td>
        <td>{{starts_at}}</td>
        <td>{{ends_at}}</td>
        <td>{{timezone}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{#if pagination}}
  <nav class="pagination" aria-label="Pagination">
    {{#if pagination.has_prev}}
    <a class="pagination-button" href="{{pagination.prev_url}}">Previous</a>
    {{/if}}
    <span class="pagination-info">Page {{pagination.page}} of {{pagination.total_pages}} ({{pagination.total}} total)</span>
    {{#if pagination.has_next}}
    <a class="pagination-button" href="{{pagination.next_url}}">Next</a>
    {{/if}}
  </nav>
  {{/if}}
  {{else}}
  <p class="empty-state"><span class="empty-state-title">No events yet.</span>{{#if empty_message}} {{empty_message}}{{/if}}</p>
  {{/if}}
</section>
