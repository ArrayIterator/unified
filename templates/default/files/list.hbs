{{!-- Files list view (module:files/list).
  Renders `items` (array of file records) with an
  optional `pagination` object. Each row may carry `detail_url` (linked
  from the first column) and `status_class` (badge modifier, for
  example `badge-success`). --}}
<section class="admin-section section-panel" data-section="files" aria-labelledby="files-list-heading">
  <h1 id="files-list-heading">{{#if title}}{{title}}{{else}}Files{{/if}}</h1>
  <p class="page-intro">Files stored in the file manager, with type and size.</p>
  {{#if is_admin_user}}
  {{#if create_url}}
  <p><a class="button" href="{{create_url}}">New file</a></p>
  {{/if}}
  {{/if}}
  {{#if items}}
  <table class="table">
    <thead>
      <tr>
        <th scope="col">Name</th>
        <th scope="col">Kind</th>
        <th scope="col">Size</th>
        <th scope="col">Type</th>
        <th scope="col">Folder</th>
      </tr>
    </thead>
    <tbody>
      {{#each items}}
      <tr>
        <td>{{#if detail_url}}<a href="{{detail_url}}">{{name}}</a>{{else}}{{name}}{{/if}}</td>
        <td>{{kind}}</td>
        <td>{{size}}</td>
        <td>{{mime}}</td>
        <td>{{folder_id}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{#if pagination}}
  <nav class="pagination" aria-label="Pagination">
    {{#if pagination.has_prev}}
    <a class="pagination-button" href="{{pagination.prev_url}}">Previous</a>
    {{/if}}
    <span class="pagination-info">Page {{pagination.page}} of {{pagination.total_pages}} ({{pagination.total}} total)</span>
    {{#if pagination.has_next}}
    <a class="pagination-button" href="{{pagination.next_url}}">Next</a>
    {{/if}}
  </nav>
  {{/if}}
  {{else}}
  <p class="empty-state"><span class="empty-state-title">No files yet.</span>{{#if empty_message}} {{empty_message}}{{/if}}</p>
  {{/if}}
</section>
