{{!-- File detail view (module:files/detail).
  Renders one file record as `item`, with an optional
  `back_url` to the list. --}}
<section class="admin-section section-panel" data-section="files" aria-labelledby="files-detail-heading">
  {{#if has_data}}
  {{#if item}}
  <h1 id="files-detail-heading">{{#if title}}{{title}}{{else}}{{item.name}}{{/if}}</h1>
  {{#if back_url}}
  <p><a class="button button-secondary button-small" href="{{back_url}}">&larr; Back to list</a></p>
  {{/if}}
  <table class="table">
    <tbody>
      <tr><th scope="row">Name</th><td>{{item.name}}</td></tr>
      <tr><th scope="row">Kind</th><td>{{item.kind}}</td></tr>
      <tr><th scope="row">Size</th><td>{{item.size}}</td></tr>
      <tr><th scope="row">Type</th><td>{{item.mime}}</td></tr>
      <tr><th scope="row">Folder</th><td>{{item.folder_id}}</td></tr>
      <tr><th scope="row">Path</th><td>{{item.path}}</td></tr>
    </tbody>
  </table>
  {{else}}
  <p class="empty-state"><span class="empty-state-title">Not found.</span></p>
  {{/if}}
  {{else}}
  <p class="empty-note">No data to show.</p>
  {{/if}}
</section>
