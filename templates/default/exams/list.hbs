{{!-- Exams list view (module:exams/list).
  Renders `items` (array of exam records) with an
  optional `pagination` object. Each row may carry `detail_url` (linked
  from the first column) and `status_class` (badge modifier, for
  example `badge-success`). --}}
<section class="admin-section section-panel" data-section="exams" aria-labelledby="exams-list-heading">
  <h1 id="exams-list-heading">{{#if title}}{{title}}{{else}}Exams{{/if}}</h1>
  <p class="page-intro">Exams with question banks, timing, and status.</p>
  {{#if is_admin_user}}
  {{#if create_url}}
  <p><a class="button" href="{{create_url}}">New exam</a></p>
  {{/if}}
  {{/if}}
  {{#if items}}
  <table class="table">
    <thead>
      <tr>
        <th scope="col">Title</th>
        <th scope="col">Category</th>
        <th scope="col">Status</th>
        <th scope="col">Duration (min)</th>
        <th scope="col">Opens</th>
        <th scope="col">Closes</th>
      </tr>
    </thead>
    <tbody>
      {{#each items}}
      <tr>
        <td>{{#if detail_url}}<a href="{{detail_url}}">{{title}}</a>{{else}}{{title}}{{/if}}</td>
        <td>{{category}}</td>
        <td><span class="badge {{#if status_class}}{{status_class}}{{else}}badge-neutral{{/if}}">{{status}}</span></td>
        <td>{{duration_minutes}}</td>
        <td>{{opens_at}}</td>
        <td>{{closes_at}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{#if pagination}}
  <nav class="pagination" aria-label="Pagination">
    {{#if pagination.has_prev}}
    <a class="pagination-button" href="{{pagination.prev_url}}">Previous</a>
    {{/if}}
    <span class="pagination-info">Page {{pagination.page}} of {{pagination.total_pages}} ({{pagination.total}} total)</span>
    {{#if pagination.has_next}}
    <a class="pagination-button" href="{{pagination.next_url}}">Next</a>
    {{/if}}
  </nav>
  {{/if}}
  {{else}}
  <p class="empty-state"><span class="empty-state-title">No exams yet.</span>{{#if empty_message}} {{empty_message}}{{/if}}</p>
  {{/if}}
</section>
