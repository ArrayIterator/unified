{{!-- Exam detail view (module:exams/detail).
  Renders one exam record as `item`, with an optional
  `back_url` to the list. --}}
<section class="admin-section section-panel" data-section="exams" aria-labelledby="exams-detail-heading">
  {{#if has_data}}
  {{#if item}}
  <h1 id="exams-detail-heading">{{#if title}}{{title}}{{else}}{{item.title}}{{/if}}</h1>
  {{#if back_url}}
  <p><a class="button button-secondary button-small" href="{{back_url}}">&larr; Back to list</a></p>
  {{/if}}
  <table class="table">
    <tbody>
      <tr><th scope="row">Title</th><td>{{item.title}}</td></tr>
      <tr><th scope="row">Description</th><td>{{item.description}}</td></tr>
      <tr><th scope="row">Category</th><td>{{item.category}}</td></tr>
      <tr><th scope="row">Question banks</th><td>{{#each item.bank_ids}}{{#unless @first}}, {{/unless}}{{this}}{{/each}}</td></tr>
      <tr><th scope="row">Course</th><td>{{item.course_id}}</td></tr>
      <tr><th scope="row">Status</th><td><span class="badge {{#if item.status_class}}{{item.status_class}}{{else}}badge-neutral{{/if}}">{{item.status}}</span></td></tr>
      <tr><th scope="row">Opens</th><td>{{item.opens_at}}</td></tr>
      <tr><th scope="row">Closes</th><td>{{item.closes_at}}</td></tr>
      <tr><th scope="row">Duration (min)</th><td>{{item.duration_minutes}}</td></tr>
    </tbody>
  </table>
  {{else}}
  <p class="empty-state"><span class="empty-state-title">Not found.</span></p>
  {{/if}}
  {{else}}
  <p class="empty-note">No data to show.</p>
  {{/if}}
</section>
