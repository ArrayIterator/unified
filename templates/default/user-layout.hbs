<!DOCTYPE html>
<html lang="en" class="theme-{{#if theme}}{{theme}}{{else}}light{{/if}}" data-theme="{{#if theme}}{{theme}}{{else}}light{{/if}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{#if title}}{{title}} &mdash; {{/if}}{{app_name}}</title>
  <meta name="description" content="Your Unified dashboard: licenses, downloads, orders, tickets, and services.">
  <link rel="stylesheet" href="{{asset_url "css/dashboard.css"}}">
  <link rel="stylesheet" href="{{asset_url "css/client.css"}}">
</head>
<body>
  <a class="skip-link" href="#user-content">Skip to content</a>
  {{> icons}}
  <div class="dashboard-shell client-shell">
    <div class="sidebar-backdrop" data-sidebar-backdrop hidden></div>
    <aside class="sidebar client-sidebar" id="sidebar" aria-label="Dashboard navigation">
      <div class="sidebar-brand">
        <a class="brand" href="/{{user_path}}">
          <span class="brand-mark" aria-hidden="true">U</span>
          <span class="brand-name">{{#if app_name}}{{app_name}}{{else}}Unified{{/if}}</span>
        </a>
        {{#if is_reseller}}<span class="scope-badge scope-badge-reseller">Reseller</span>{{else}}<span class="scope-badge scope-badge-user">My account</span>{{/if}}
        <button type="button" class="icon-button sidebar-collapse" data-sidebar-collapse aria-label="Collapse sidebar" aria-expanded="true">
          <svg class="icon" aria-hidden="true"><use href="#icon-chevron-down"></use></svg>
        </button>
        <button type="button" class="sidebar-close" data-sidebar-toggle aria-label="Close sidebar" aria-expanded="false">&times;</button>
      </div>
      {{> user-nav}}
    </aside>

    <div class="dashboard-main">
      <header class="dashboard-topbar client-topbar">
        <button type="button" class="icon-button sidebar-open" data-sidebar-toggle aria-label="Open navigation" aria-expanded="false">
          <svg class="icon" aria-hidden="true"><use href="#icon-menu"></use></svg>
        </button>
        <p class="topbar-title">{{#if title}}{{title}}{{else}}Dashboard{{/if}}</p>
        {{#if user}}
        <span class="topbar-user">{{user.name}} &lt;{{user.email}}&gt;</span>
        {{/if}}
        <button type="button" class="icon-button" data-theme-toggle aria-label="Switch to dark theme">
          <span data-theme-icon aria-hidden="true"><svg class="icon"><use href="#icon-moon"></use></svg></span>
          <span class="theme-toggle-label">Dark</span>
        </button>
      </header>

      {{#if view_as.active}}
      <div class="view-as-banner" role="alert" data-view-as-banner>
        <svg class="icon" aria-hidden="true"><use href="#icon-alert"></use></svg>
        <p>
          <strong>An administrator is viewing as you</strong>
          {{#if view_as.expires_at}}&mdash; session expires {{view_as.expires_at}}{{/if}}
          {{#if view_as.reason}}&mdash; {{view_as.reason}}{{/if}}
        </p>
        <button type="button" class="view-as-stop" data-view-as-stop>Stop viewing as user</button>
      </div>
      {{/if}}

      <main class="layout-main" id="user-content">
        {{{body}}}
      </main>
    </div>
  </div>

  <script src="{{asset_url "js/dashboard.js"}}" defer></script>
  <script src="{{asset_url "js/client.js"}}" defer></script>
</body>
</html>
