{{!-- Course detail view (module:elearning/detail).
  Renders one course record as `item`, with an optional
  `back_url` to the list. --}}
<section class="admin-section section-panel" data-section="elearning" aria-labelledby="elearning-detail-heading">
  {{#if has_data}}
  {{#if item}}
  <h1 id="elearning-detail-heading">{{#if title}}{{title}}{{else}}{{item.title}}{{/if}}</h1>
  {{#if back_url}}
  <p><a class="button button-secondary button-small" href="{{back_url}}">&larr; Back to list</a></p>
  {{/if}}
  <table class="table">
    <tbody>
      <tr><th scope="row">Title</th><td>{{item.title}}</td></tr>
      <tr><th scope="row">Description</th><td>{{item.description}}</td></tr>
      <tr><th scope="row">Category</th><td>{{item.category}}</td></tr>
      <tr><th scope="row">Level</th><td>{{item.level}}</td></tr>
      <tr><th scope="row">Language</th><td>{{item.language}}</td></tr>
      <tr><th scope="row">Instructor</th><td>{{item.instructor_id}}</td></tr>
      <tr><th scope="row">Status</th><td><span class="badge {{#if item.status_class}}{{item.status_class}}{{else}}badge-neutral{{/if}}">{{item.status}}</span></td></tr>
      <tr><th scope="row">Price</th><td>{{item.price_minor}} {{item.currency}}</td></tr>
      <tr><th scope="row">Certificate</th><td>{{#if item.certificate_enabled}}Yes{{else}}No{{/if}}</td></tr>
    </tbody>
  </table>
  {{else}}
  <p class="empty-state"><span class="empty-state-title">Not found.</span></p>
  {{/if}}
  {{else}}
  <p class="empty-note">No data to show.</p>
  {{/if}}
</section>
