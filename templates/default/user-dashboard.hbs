{{#if section_overview}}
<section class="user-overview" data-section="{{section}}">
  <h1>Your dashboard</h1>
  <p class="page-intro">Your licenses, downloads, orders, tickets, and services in one place.</p>

  <div class="stat-grid">
    <article class="stat-card">
      <h2>Licenses</h2>
      <p class="stat-value">{{overview.counts.licenses}}</p>
      <p class="stat-note">{{overview.counts.active_licenses}} active</p>
    </article>
    <article class="stat-card">
      <h2>Downloads</h2>
      <p class="stat-value">{{overview.counts.downloads}}</p>
      <p class="stat-note">Across your licenses</p>
    </article>
    <article class="stat-card">
      <h2>Orders</h2>
      <p class="stat-value">{{overview.counts.orders}}</p>
      <p class="stat-note">Your store orders</p>
    </article>
    <article class="stat-card">
      <h2>Entitlements</h2>
      <p class="stat-value">{{overview.counts.entitlements}}</p>
      <p class="stat-note">Granted with your orders</p>
    </article>
  </div>

  {{#unless overview.db_available}}
  <p class="empty-note">Your data is unavailable right now: no database is configured.</p>
  {{/unless}}

  <div class="panel-grid">
    <section class="panel" aria-labelledby="recent-licenses-heading">
      <h2 id="recent-licenses-heading">Recent licenses</h2>
      {{#if overview.recent_licenses}}
      <ul class="record-list">
        {{#each overview.recent_licenses}}
        <li>
          <span class="record-name">{{product}}</span>
          <span class="record-meta">{{status}}{{#if expires_at}} &middot; expires {{expires_at}}{{/if}}</span>
        </li>
        {{/each}}
      </ul>
      {{else}}
      <p class="empty-note">No licenses yet.</p>
      {{/if}}
    </section>

    <section class="panel" aria-labelledby="recent-orders-heading">
      <h2 id="recent-orders-heading">Recent orders</h2>
      {{#if overview.recent_orders}}
      <ul class="record-list">
        {{#each overview.recent_orders}}
        <li>
          <span class="record-name">{{status}}</span>
          <span class="record-meta">{{total}} {{currency}}</span>
        </li>
        {{/each}}
      </ul>
      {{else}}
      <p class="empty-note">No orders yet.</p>
      {{/if}}
    </section>

    <section class="panel" aria-labelledby="support-sections-heading">
      <h2 id="support-sections-heading">Tickets, services &amp; API keys</h2>
      <ul class="section-list">
        {{#each overview.sections}}
        <li>
          <span class="section-name">{{section}}</span>
          {{#if available}}
          <span class="section-status section-status-ok">Available</span>
          {{else}}
          <span class="section-status">Not connected &mdash; {{reason}}</span>
          {{/if}}
        </li>
        {{/each}}
      </ul>
    </section>

    {{#if reseller.clients_total}}
    <section class="panel" aria-labelledby="reseller-heading">
      <h2 id="reseller-heading">Your clients</h2>
      <p class="stat-value">{{reseller.clients_total}} clients</p>
      <p class="stat-note">{{reseller.counts.client_orders}} client orders &middot; {{reseller.counts.client_orders_value}} total value</p>
      <ul class="section-list">
        {{#each reseller.sections}}
        <li>
          <span class="section-name">{{section}}</span>
          {{#if available}}
          <span class="section-status section-status-ok">Available</span>
          {{else}}
          <span class="section-status">Not connected &mdash; {{reason}}</span>
          {{/if}}
        </li>
        {{/each}}
      </ul>
    </section>
    {{/if}}
  </div>
</section>
{{/if}}

{{#if section_licenses}}
<section class="user-section section-panel" data-section="licenses" aria-labelledby="user-licenses-heading">
  <h1 id="user-licenses-heading">My Licenses</h1>
  <p class="page-intro">Licenses issued to your account. Loaded live from the dashboards API.</p>
  <div id="user-licenses-list"><p>Loading licenses…</p></div>
</section>
{{/if}}

{{#if section_downloads}}
<section class="user-section section-panel" data-section="downloads" aria-labelledby="user-downloads-heading">
  <h1 id="user-downloads-heading">My Downloads</h1>
  <p class="page-intro">Downloads available under your licenses. Loaded live from the dashboards API.</p>
  <div id="user-downloads-list"><p>Loading downloads…</p></div>
</section>
{{/if}}

{{#if section_orders}}
<section class="user-section section-panel" data-section="orders" aria-labelledby="user-orders-heading">
  <h1 id="user-orders-heading">My Orders</h1>
  <p class="page-intro">Your store orders. Loaded live from the dashboards API.</p>
  <div id="user-orders-list"><p>Loading orders…</p></div>
</section>
{{/if}}

{{#if section_school_fees}}
<section class="user-section section-panel" data-section="school-fees" aria-labelledby="user-fees-heading">
  <h1 id="user-fees-heading">My School Fees</h1>
  <p class="page-intro">Your school fee records.</p>
  {{#if section_data.available}}
  <p class="section-status section-status-ok">School fee data is available from its owning module.</p>
  {{else}}
  <p class="empty-note">School fee details are not connected yet{{#if section_data.reason}} &mdash; {{section_data.reason}}{{/if}}.</p>
  {{/if}}
</section>
{{/if}}

{{#if section_tickets}}
<section class="user-section section-panel" data-section="tickets" aria-labelledby="user-tickets-heading">
  <h1 id="user-tickets-heading">My Tickets</h1>
  <p class="page-intro">Your support tickets.</p>
  {{#if section_data.available}}
  <p class="section-status section-status-ok">Ticket data is available from its owning module.</p>
  {{else}}
  <p class="empty-note">Ticket details are not connected yet{{#if section_data.reason}} &mdash; {{section_data.reason}}{{/if}}.</p>
  {{/if}}
</section>
{{/if}}

{{#if section_services}}
<section class="user-section section-panel" data-section="services" aria-labelledby="user-services-heading">
  <h1 id="user-services-heading">My Services</h1>
  <p class="page-intro">Services running under your account.</p>
  {{#if section_data.available}}
  <p class="section-status section-status-ok">Service data is available from its owning module.</p>
  {{else}}
  <p class="empty-note">Service details are not connected yet{{#if section_data.reason}} &mdash; {{section_data.reason}}{{/if}}.</p>
  {{/if}}
</section>
{{/if}}

{{#if section_apikeys}}
<section class="user-section section-panel" data-section="apikeys" aria-labelledby="user-apikeys-heading">
  <h1 id="user-apikeys-heading">API Keys</h1>
  <p class="page-intro">API keys for your account.</p>
  {{#if section_data.available}}
  <p class="section-status section-status-ok">API key data is available from its owning module.</p>
  {{else}}
  <p class="empty-note">API keys are not connected yet{{#if section_data.reason}} &mdash; {{section_data.reason}}{{/if}}. Keys are managed by the API keys module.</p>
  {{/if}}
</section>
{{/if}}

{{#if section_profile}}
<section class="user-section section-panel" data-section="profile" aria-labelledby="user-profile-heading">
  <h1 id="user-profile-heading">Profile</h1>
  <p class="page-intro">Your account details, as stored for your user id.</p>
  {{#if user}}
  <dl class="record-list">
    <div><dt>Name</dt><dd>{{user.name}}</dd></div>
    <div><dt>Email</dt><dd>{{user.email}}</dd></div>
    <div><dt>User id</dt><dd>{{user.id}}</dd></div>
    {{#if user.company_id}}<div><dt>Company id</dt><dd>{{user.company_id}}</dd></div>{{/if}}
  </dl>
  {{else}}
  <p class="empty-note">No profile is available for this session.</p>
  {{/if}}
  <p class="field-help">Profile changes are made by an administrator through the users API.</p>
</section>
{{/if}}

{{#if section_reseller_clients}}
<section class="user-section section-panel" data-section="reseller/clients" aria-labelledby="reseller-clients-heading">
  <h1 id="reseller-clients-heading">My Clients</h1>
  <p class="page-intro">Clients linked to your reseller account.</p>
  <p class="stat-note">{{reseller.clients_total}} linked clients.</p>
  {{#if reseller.client_ids}}
  <ul class="record-list">
    {{#each reseller.client_ids}}
    <li><span class="record-name">{{this}}</span></li>
    {{/each}}
  </ul>
  {{else}}
  <p class="empty-note">No clients are linked yet. Link a client from the reseller API.</p>
  {{/if}}
</section>
{{/if}}

{{#if section_reseller_payouts}}
<section class="user-section section-panel" data-section="reseller/payouts" aria-labelledby="reseller-payouts-heading">
  <h1 id="reseller-payouts-heading">Commissions &amp; Payouts</h1>
  <p class="page-intro">Commission totals for your linked clients.</p>
  <p class="stat-note">{{reseller.counts.client_orders}} client orders &middot; {{reseller.counts.client_orders_value}} total value.</p>
  {{#if section_data.available}}
  <p class="section-status section-status-ok">Commission data is available from its owning module.</p>
  {{else}}
  <p class="empty-note">Commission details are not connected yet{{#if section_data.reason}} &mdash; {{section_data.reason}}{{/if}}.</p>
  {{/if}}
</section>
{{/if}}
