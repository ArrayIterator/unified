{{!-- Projects list view (module:projects/list).
  Renders `items` (array of project records) with an
  optional `pagination` object. Each row may carry `detail_url` (linked
  from the first column) and `status_class` (badge modifier, for
  example `badge-success`). --}}
<section class="admin-section section-panel" data-section="projects" aria-labelledby="projects-list-heading">
  <h1 id="projects-list-heading">{{#if title}}{{title}}{{else}}Projects{{/if}}</h1>
  <p class="page-intro">Projects tracked with methodology, status, and due dates.</p>
  {{#if is_admin_user}}
  {{#if create_url}}
  <p><a class="button" href="{{create_url}}">New project</a></p>
  {{/if}}
  {{/if}}
  {{#if items}}
  <table class="table">
    <thead>
      <tr>
        <th scope="col">Name</th>
        <th scope="col">Methodology</th>
        <th scope="col">Status</th>
        <th scope="col">Visibility</th>
        <th scope="col">Due</th>
      </tr>
    </thead>
    <tbody>
      {{#each items}}
      <tr>
        <td>{{#if detail_url}}<a href="{{detail_url}}">{{name}}</a>{{else}}{{name}}{{/if}}</td>
        <td>{{methodology}}</td>
        <td><span class="badge {{#if status_class}}{{status_class}}{{else}}badge-neutral{{/if}}">{{status}}</span></td>
        <td>{{visibility}}</td>
        <td>{{due_date}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{#if pagination}}
  <nav class="pagination" aria-label="Pagination">
    {{#if pagination.has_prev}}
    <a class="pagination-button" href="{{pagination.prev_url}}">Previous</a>
    {{/if}}
    <span class="pagination-info">Page {{pagination.page}} of {{pagination.total_pages}} ({{pagination.total}} total)</span>
    {{#if pagination.has_next}}
    <a class="pagination-button" href="{{pagination.next_url}}">Next</a>
    {{/if}}
  </nav>
  {{/if}}
  {{else}}
  <p class="empty-state"><span class="empty-state-title">No projects yet.</span>{{#if empty_message}} {{empty_message}}{{/if}}</p>
  {{/if}}
</section>
