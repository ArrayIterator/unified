{{!-- Project detail view (module:projects/detail).
  Renders one project record as `item`, with an optional
  `back_url` to the list. --}}
<section class="admin-section section-panel" data-section="projects" aria-labelledby="projects-detail-heading">
  {{#if has_data}}
  {{#if item}}
  <h1 id="projects-detail-heading">{{#if title}}{{title}}{{else}}{{item.name}}{{/if}}</h1>
  {{#if back_url}}
  <p><a class="button button-secondary button-small" href="{{back_url}}">&larr; Back to list</a></p>
  {{/if}}
  <table class="table">
    <tbody>
      <tr><th scope="row">Name</th><td>{{item.name}}</td></tr>
      <tr><th scope="row">Description</th><td>{{item.description}}</td></tr>
      <tr><th scope="row">Methodology</th><td>{{item.methodology}}</td></tr>
      <tr><th scope="row">Status</th><td><span class="badge {{#if item.status_class}}{{item.status_class}}{{else}}badge-neutral{{/if}}">{{item.status}}</span></td></tr>
      <tr><th scope="row">Visibility</th><td>{{item.visibility}}</td></tr>
      <tr><th scope="row">Owner</th><td>{{item.owner_id}}</td></tr>
      <tr><th scope="row">Company</th><td>{{item.company_id}}</td></tr>
      <tr><th scope="row">Client</th><td>{{item.client_id}}</td></tr>
      <tr><th scope="row">Started</th><td>{{item.start_date}}</td></tr>
      <tr><th scope="row">Due</th><td>{{item.due_date}}</td></tr>
    </tbody>
  </table>
  {{else}}
  <p class="empty-state"><span class="empty-state-title">Not found.</span></p>
  {{/if}}
  {{else}}
  <p class="empty-note">No data to show.</p>
  {{/if}}
</section>
