<!DOCTYPE html>
<html lang="en" class="theme-{{#if theme}}{{theme}}{{else}}light{{/if}}" data-theme="{{#if theme}}{{theme}}{{else}}light{{/if}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard &mdash; {{#if app_name}}{{app_name}}{{else}}Unified{{/if}}</title>
  <meta name="description" content="Unified administration dashboard.">
  <link rel="stylesheet" href="/assets/css/dashboard.css">
</head>
<body>
  <div class="dashboard-shell">
    <aside class="sidebar" id="sidebar" aria-label="Dashboard navigation">
      <div class="sidebar-brand">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">U</span>
          <span class="brand-name">{{#if app_name}}{{app_name}}{{else}}Unified{{/if}}</span>
        </a>
        <button type="button" class="sidebar-close" data-sidebar-toggle aria-label="Close sidebar">&times;</button>
      </div>
      <nav class="sidebar-nav" aria-label="Modules">
        <p class="sidebar-section">Navigate</p>
        <a class="sidebar-link is-active" href="/dashboard">Dashboard</a>
        {{#if nav}}
        {{#each nav}}
        <a class="sidebar-link{{#if active}} is-active{{/if}}" href="{{url}}">{{label}}</a>
        {{/each}}
        {{/if}}
        <p class="sidebar-section">Modules</p>
        <span id="module-nav-list">
          {{#if modules}}
          {{#each modules}}
          <a class="sidebar-link" href="/dashboard/{{id}}">{{name}}</a>
          {{/each}}
          {{else}}
          <span class="sidebar-empty">No modules registered yet.</span>
          {{/if}}
        </span>
      </nav>
      <div class="sidebar-footer">
        {{#if user}}
        <span class="user-chip">{{user.name}}</span>
        {{else}}
        <a class="button button-small" href="/login">Sign in</a>
        {{/if}}
      </div>
    </aside>

    <div class="dashboard-main">
      <header class="topbar">
        <button type="button" class="sidebar-open" data-sidebar-toggle aria-label="Open sidebar">&#9776;</button>
        <form class="topbar-search" action="/dashboard" method="get" role="search">
          <label class="visually-hidden" for="dashboard-search">Search</label>
          <input id="dashboard-search" name="search" type="search" placeholder="Search modules, sites, tickets&hellip;" value="{{#if search_query}}{{search_query}}{{/if}}" data-dashboard-search>
        </form>
        <div class="topbar-actions">
          <button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle dark or light theme">
            <span aria-hidden="true">&#9788;</span>
            <span class="theme-toggle-label">Theme</span>
          </button>
          {{#if user}}
          <span class="user-chip">{{user.name}}</span>
          {{/if}}
        </div>
      </header>

      <main class="dashboard-content">
        {{#if flash}}
        <div class="flash flash-{{flash.type}}" role="alert" data-flash>{{flash.message}}</div>
        {{/if}}

        <div class="page-heading">
          <h1>Dashboard</h1>
          {{#if user}}
          <p>Welcome back, {{user.name}}.</p>
          {{else}}
          <p>Overview of your Unified installation.</p>
          {{/if}}
        </div>

        <section class="stat-grid" aria-label="Overview statistics">
          {{#if stats}}
          {{#each stats}}
          <article class="stat-card">
            <p class="stat-label">{{label}}</p>
            <p class="stat-value">{{value}}</p>
            {{#if change}}<p class="stat-change">{{change}}</p>{{/if}}
          </article>
          {{/each}}
          {{else}}
          <article class="stat-card">
            <p class="stat-label">Modules</p>
            <p class="stat-value">{{#if counts}}{{counts.modules_total}}{{else}}0{{/if}}</p>
            <p class="stat-change">No statistics available yet.</p>
          </article>
          <article class="stat-card">
            <p class="stat-label">Sites</p>
            <p class="stat-value">{{#if counts}}{{counts.sites_total}}{{else}}0{{/if}}</p>
            <p class="stat-change">No statistics available yet.</p>
          </article>
          <article class="stat-card">
            <p class="stat-label">Open tickets</p>
            <p class="stat-value">{{#if counts}}{{counts.tickets_open}}{{else}}0{{/if}}</p>
            <p class="stat-change">No statistics available yet.</p>
          </article>
          <article class="stat-card">
            <p class="stat-label">Orders</p>
            <p class="stat-value">{{#if counts}}{{counts.orders_total}}{{else}}0{{/if}}</p>
            <p class="stat-change">No statistics available yet.</p>
          </article>
          {{/if}}
        </section>

        <section class="panel" aria-label="Modules">
          <div class="panel-heading">
            <h2>Modules</h2>
            <span class="panel-meta" data-module-count>
              {{#if modules}}{{modules.length}} registered{{else}}None registered{{/if}}
            </span>
          </div>
          <div class="module-grid" id="module-grid" data-module-grid>
            {{#if modules}}
            {{#each modules}}
            <article class="module-card">
              <h3>{{name}}</h3>
              <p class="module-description">{{description}}</p>
              <p class="module-meta">
                <span class="badge{{#if enabled}} badge-enabled{{else}} badge-disabled{{/if}}">{{#if enabled}}Enabled{{else}}Disabled{{/if}}</span>
                {{#if version}}<span>v{{version}}</span>{{/if}}
              </p>
              <a class="button button-small" href="/dashboard/{{id}}">Open</a>
            </article>
            {{/each}}
            {{else}}
            <p class="empty-state">No modules registered yet. Modules appear here once they are registered with the application.</p>
            {{/if}}
          </div>
          <p class="panel-note" data-module-status role="status"></p>
        </section>

        <section class="panel" aria-label="Recent activity">
          <div class="panel-heading">
            <h2>Recent activity</h2>
          </div>
          {{#if activities}}
          <ul class="activity-feed">
            {{#each activities}}
            <li class="activity-item">
              <span class="activity-time">{{time}}</span>
              <span class="activity-text">{{text}}</span>
            </li>
            {{/each}}
          </ul>
          {{else}}
          <p class="empty-state">No recent activity yet. Events from modules — logins, orders, tickets, deployments — will show up here.</p>
          {{/if}}
        </section>
      </main>

      {{> footer}}
    </div>
  </div>
  <script src="/assets/js/dashboard.js" defer></script>
</body>
</html>
