<!DOCTYPE html>
<html lang="en" class="theme-{{#if theme}}{{theme}}{{else}}light{{/if}}" data-theme="{{#if theme}}{{theme}}{{else}}light{{/if}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{#if app_name}}{{app_name}}{{else}}Unified{{/if}}{{#if tagline}} &mdash; {{tagline}}{{/if}}</title>
  {{#if description}}<meta name="description" content="{{description}}">{{/if}}
  <link rel="stylesheet" href="/assets/css/dashboard.css">
</head>
<body>
  {{> header}}

  <main class="home-main">
    <section class="hero">
      <h1>{{#if app_name}}{{app_name}}{{else}}Unified{{/if}}</h1>
      {{#if tagline}}<p class="hero-tagline">{{tagline}}</p>{{/if}}
      {{#if description}}<p class="hero-description">{{description}}</p>{{/if}}
      <p class="hero-actions">
        <a class="button" href="{{#if dashboard_url}}{{dashboard_url}}{{else}}/dashboard{{/if}}">Open dashboard</a>
        {{#if login_url}}<a class="button button-secondary" href="{{login_url}}">Sign in</a>{{/if}}
      </p>
    </section>

    {{#if features}}
    <section class="feature-grid" aria-label="Features">
      {{#each features}}
      <article class="feature-card">
        <h2>{{title}}</h2>
        <p>{{description}}</p>
      </article>
      {{/each}}
    </section>
    {{else}}
    <section class="feature-grid" aria-label="Features">
      <article class="feature-card">
        <h2>One control plane</h2>
        <p>Licensing, downloads, storefront, software and asset management, and day-to-day operations in one place.</p>
      </article>
      <article class="feature-card">
        <h2>Modular by design</h2>
        <p>Every capability is a module that can be enabled, configured, and interconnected through the hook bus.</p>
      </article>
      <article class="feature-card">
        <h2>Built for teams</h2>
        <p>Companies, sites, domains, billing, and support tickets share one login and one dashboard.</p>
      </article>
    </section>
    {{/if}}

    {{#if counts}}
    <section class="home-stats" aria-label="Installation statistics">
      <p><strong>{{counts.modules_total}}</strong> modules registered &middot; <strong>{{counts.sites_total}}</strong> sites &middot; <strong>{{counts.users_total}}</strong> users</p>
    </section>
    {{/if}}
  </main>

  {{> footer}}
  <script src="/assets/js/dashboard.js" defer></script>
</body>
</html>
