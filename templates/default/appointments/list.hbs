{{!-- Appointments list view (module:appointments/list).
  Renders `items` (array of appointment records) with an
  optional `pagination` object. Each row may carry `detail_url` (linked
  from the first column) and `status_class` (badge modifier, for
  example `badge-success`). --}}
<section class="admin-section section-panel" data-section="appointments" aria-labelledby="appointments-list-heading">
  <h1 id="appointments-list-heading">{{#if title}}{{title}}{{else}}Appointments{{/if}}</h1>
  <p class="page-intro">Booked appointments with services, staff, and customers.</p>
  {{#if is_admin_user}}
  {{#if create_url}}
  <p><a class="button" href="{{create_url}}">New appointment</a></p>
  {{/if}}
  {{/if}}
  {{#if items}}
  <table class="table">
    <thead>
      <tr>
        <th scope="col">Customer</th>
        <th scope="col">Service</th>
        <th scope="col">Staff</th>
        <th scope="col">Starts</th>
        <th scope="col">Ends</th>
      </tr>
    </thead>
    <tbody>
      {{#each items}}
      <tr>
        <td>{{#if detail_url}}<a href="{{detail_url}}">{{customer_name}}</a>{{else}}{{customer_name}}{{/if}}</td>
        <td>{{service_id}}</td>
        <td>{{staff_user_id}}</td>
        <td>{{starts_at}}</td>
        <td>{{ends_at}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{#if pagination}}
  <nav class="pagination" aria-label="Pagination">
    {{#if pagination.has_prev}}
    <a class="pagination-button" href="{{pagination.prev_url}}">Previous</a>
    {{/if}}
    <span class="pagination-info">Page {{pagination.page}} of {{pagination.total_pages}} ({{pagination.total}} total)</span>
    {{#if pagination.has_next}}
    <a class="pagination-button" href="{{pagination.next_url}}">Next</a>
    {{/if}}
  </nav>
  {{/if}}
  {{else}}
  <p class="empty-state"><span class="empty-state-title">No appointments yet.</span>{{#if empty_message}} {{empty_message}}{{/if}}</p>
  {{/if}}
</section>
