{{!-- Command palette overlay + toast region, shared by every page.
     Open with Ctrl/Command+K or any `[data-palette-open]` button.
     The palette searches the navigation links already on the page; there
     is no global search API yet, and the footer says so honestly.
--}}
<div class="palette-overlay" id="command-palette" hidden>
  <div class="palette" role="dialog" aria-modal="true" aria-label="Search and commands">
    <div class="palette-input-row">
      <svg class="icon" aria-hidden="true"><use href="#icon-search"></use></svg>
      <input type="text" placeholder="Search navigation and commands&hellip;" aria-label="Search navigation and commands" data-palette-input>
      <kbd>Esc</kbd>
    </div>
    <div class="palette-list" data-palette-list role="listbox" aria-label="Results"></div>
    <div class="palette-footer">
      <span><kbd>&uarr;</kbd> <kbd>&darr;</kbd> to navigate</span>
      <span><kbd>Enter</kbd> to open</span>
      <span>Searches this page&rsquo;s navigation only &mdash; no global search yet</span>
    </div>
  </div>
</div>

<div class="toast-region" id="toast-region" aria-live="polite"></div>
