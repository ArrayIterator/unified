<section class="auth-card" aria-labelledby="forgot-heading">
  <h1 id="forgot-heading">Forgot password</h1>
  <p class="page-intro">Enter the email address for your account and we will send you a password-reset link (valid for 60 minutes, single use).</p>

  <div id="forgot-status" class="flash" role="alert" hidden></div>

  <form id="forgot-form" autocomplete="on" novalidate>
    <div class="field">
      <label for="forgot-email" class="field-required">Email</label>
      <input id="forgot-email" name="email" type="email" required autocomplete="username" placeholder="you@example.com">
    </div>
    <button class="button button-block" type="submit" id="forgot-submit">Send reset link</button>
  </form>

  <p class="auth-links">
    <a class="button" href="{{login_url}}">Back to sign in</a>
    <a class="button button-secondary" href="{{register_url}}">Create an account</a>
  </p>
</section>
<script>
(function () {
  var form = document.getElementById("forgot-form");
  if (!form) return;
  var status = document.getElementById("forgot-status");
  function show(message, ok) {
    status.textContent = message;
    status.classList.toggle("flash-success", !!ok);
    status.classList.toggle("flash-error", !ok);
    status.hidden = false;
  }
  form.addEventListener("submit", function (event) {
    event.preventDefault();
    var email = document.getElementById("forgot-email").value.trim();
    if (!email) {
      show("Enter the email address for your account.", false);
      return;
    }
    status.hidden = true;
    fetch("/api/v1/auth-manager/password/forgot", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email: email })
    }).then(function (response) { return response.json(); }).then(function (data) {
      if (data && data.data && data.data.message) {
        show(data.data.message, true);
        form.hidden = true;
      } else if (data && data.error && data.error.message) {
        show(data.error.message, false);
      } else {
        show("If an account exists for that email address, a password-reset link has been sent.", true);
        form.hidden = true;
      }
    }).catch(function () {
      show("Could not reach the server. Try again later.", false);
    });
  });
})();
</script>
