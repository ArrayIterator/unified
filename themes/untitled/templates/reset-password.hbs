<section class="auth-card" aria-labelledby="reset-heading">
  <h1 id="reset-heading">Reset password</h1>
  <p class="page-intro">Choose a new password for your account. The link in your email is valid for 60 minutes and can only be used once.</p>

  <div id="reset-status" class="flash" role="alert" hidden></div>

  <form id="reset-form" autocomplete="off" novalidate>
    <div class="field">
      <label for="reset-password" class="field-required">New password</label>
      <input id="reset-password" name="new_password" type="password" required autocomplete="new-password" placeholder="New password">
      <p class="field-help">At least 12 characters, with upper- and lowercase letters, a digit, and a symbol.</p>
    </div>
    <div class="field">
      <label for="reset-password-confirm" class="field-required">Confirm new password</label>
      <input id="reset-password-confirm" name="new_password_confirm" type="password" required autocomplete="new-password" placeholder="Repeat the new password">
    </div>
    <button class="button button-block" type="submit" id="reset-submit">Reset password</button>
  </form>

  <p class="auth-links">
    <a class="button" href="{{login_url}}">Back to sign in</a>
    <a class="button button-secondary" href="{{forgot_url}}">Forgot password</a>
  </p>
</section>
<script>
(function () {
  var form = document.getElementById("reset-form");
  if (!form) return;
  var status = document.getElementById("reset-status");
  var token = new URLSearchParams(window.location.search).get("token") || "";
  function show(message, ok) {
    status.textContent = message;
    status.classList.toggle("flash-success", !!ok);
    status.classList.toggle("flash-error", !ok);
    status.hidden = false;
  }
  if (!token) {
    show("This reset link is missing its token. Request a new link from the forgot-password page.", false);
    form.hidden = true;
    return;
  }
  form.addEventListener("submit", function (event) {
    event.preventDefault();
    var password = document.getElementById("reset-password").value;
    var confirm = document.getElementById("reset-password-confirm").value;
    if (password !== confirm) {
      show("The two passwords do not match.", false);
      return;
    }
    status.hidden = true;
    fetch("/api/v1/auth-manager/password/reset", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ token: token, new_password: password })
    }).then(function (response) { return response.json(); }).then(function (data) {
      if (data && data.data && data.data.message) {
        show(data.data.message, true);
        form.hidden = true;
      } else if (data && data.error && data.error.message) {
        show(data.error.message, false);
      } else {
        show("Your password has been reset. Sign in with the new password.", true);
        form.hidden = true;
      }
    }).catch(function () {
      show("Could not reach the server. Try again later.", false);
    });
  });
})();
</script>
