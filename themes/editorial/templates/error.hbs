<!DOCTYPE html>
<html lang="en" class="theme-dark editorial" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{#if code}}Error {{code}}{{else}}Error{{/if}} &mdash; {{#if app_name}}{{app_name}}{{else}}Unified{{/if}}</title>
  <meta name="description" content="An error occurred.">
  <link rel="stylesheet" href="/assets/css/dashboard.css">
  <link rel="stylesheet" href="{{asset_url "theme:editorial.css"}}">
</head>
<body>
  <a class="skip-link" href="#error-content">Skip to content</a>
  {{> icons}}
  {{> header}}

  <main class="error-main" id="error-content">
    <section class="error-card" role="alert">
      <svg class="icon icon-xl empty-state-icon" aria-hidden="true"><use href="#icon-alert"></use></svg>
      {{#if code}}<p class="error-code">{{code}}</p>{{/if}}
      <h1>{{#if title}}{{title}}{{else}}Error{{/if}}</h1>
      {{#if message}}<p class="error-message">{{message}}</p>{{/if}}
      {{#if request_id}}<p class="error-request">Request id: {{request_id}}</p>{{/if}}
      <p class="error-actions">
        <a class="button" href="{{#if home_url}}{{home_url}}{{else}}/{{/if}}">
          <svg class="icon" aria-hidden="true"><use href="#icon-home"></use></svg>
          Back to home
        </a>
        <a class="button button-secondary" href="{{route_url "user_dashboard"}}">Open dashboard</a>
      </p>
    </section>
  </main>

  {{> footer}}
  {{> palette}}
  <script src="/assets/js/dashboard.js" defer></script>
</body>
</html>
