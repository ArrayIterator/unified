{{#if section_overview}}
<section class="admin-overview" data-section="{{section}}">
  <h1>Admin overview</h1>
  <p class="page-intro">System status, modules, users, orders, and security at a glance.</p>

  <div class="stat-grid">
    <article class="stat-card">
      <h2>Users</h2>
      <p class="stat-value">{{overview.counts.users}}</p>
      <p class="stat-note">Registered users</p>
    </article>
    <article class="stat-card">
      <h2>Roles</h2>
      <p class="stat-value">{{overview.counts.roles}}</p>
      <p class="stat-note">Roles in the system</p>
    </article>
    <article class="stat-card">
      <h2>Licenses</h2>
      <p class="stat-value">{{overview.counts.licenses}}</p>
      <p class="stat-note">Licenses issued</p>
    </article>
    <article class="stat-card">
      <h2>Orders</h2>
      <p class="stat-value">{{overview.counts.orders}}</p>
      <p class="stat-note">Store orders</p>
    </article>
    <article class="stat-card">
      <h2>Modules</h2>
      <p class="stat-value">{{overview.system.modules_total}}</p>
      <p class="stat-note">
        {{#if overview.system.dependencies_valid}}Dependencies valid{{else}}Dependency issues found{{/if}}
      </p>
    </article>
    <article class="stat-card">
      <h2>Uptime</h2>
      <p class="stat-value">{{overview.system.uptime_seconds}}s</p>
      <p class="stat-note">
        {{#if overview.system.maintenance}}Maintenance mode{{else}}{{#if overview.system.paused}}Paused{{else}}Running{{/if}}{{/if}}
        {{#unless overview.system.db_available}} &middot; No database{{/unless}}
      </p>
    </article>
  </div>

  <div class="panel-grid">
    <section class="panel" aria-labelledby="admin-modules-heading">
      <h2 id="admin-modules-heading">Module status</h2>
      {{#if overview.system.modules}}
      <ul class="module-list">
        {{#each overview.system.modules}}
        <li>
          <span class="module-name">{{name}}</span>
          <span class="module-id">{{id}} &middot; v{{version}}</span>
        </li>
        {{/each}}
      </ul>
      {{else}}
      <p class="empty-note">No modules registered.</p>
      {{/if}}
      {{#unless overview.system.dependencies_valid}}
      <ul class="issue-list">
        {{#each overview.system.dependency_issues}}
        <li>{{message}}</li>
        {{/each}}
      </ul>
      {{/unless}}
    </section>

    <section class="panel" aria-labelledby="admin-sections-heading">
      <h2 id="admin-sections-heading">Operations</h2>
      <ul class="section-list">
        {{#each overview.sections}}
        <li>
          <span class="section-name">{{section}}</span>
          {{#if available}}
          <span class="section-status section-status-ok">Available</span>
          {{else}}
          <span class="section-status">Not connected &mdash; {{reason}}</span>
          {{/if}}
        </li>
        {{/each}}
      </ul>
      <p class="panel-note">Servers, security, and logs are provided by their owning modules through the dashboard section hook.</p>
    </section>
  </div>
</section>
{{/if}}

{{#if section_modules}}
<section class="admin-section section-panel" data-section="modules" aria-labelledby="admin-modules-page-heading">
  <h1 id="admin-modules-page-heading">Modules</h1>
  <p class="page-intro">Every registered module, with dependency validation. Loaded live from the dashboards API.</p>
  <div id="admin-modules-list"><p>Loading modules…</p></div>
</section>
{{/if}}

{{#if section_users}}
<section class="admin-section section-panel" data-section="users" aria-labelledby="admin-users-page-heading">
  <h1 id="admin-users-page-heading">Users &amp; Roles</h1>
  <p class="page-intro">Registered users with their roles. Loaded live from the dashboards API.</p>
  <div id="admin-users-list"><p>Loading users…</p></div>
</section>
{{/if}}

{{#if section_orders}}
<section class="admin-section section-panel" data-section="orders" aria-labelledby="admin-orders-page-heading">
  <h1 id="admin-orders-page-heading">Orders &amp; Invoices</h1>
  <p class="page-intro">Store orders across all customers.</p>
  <p class="stat-note">{{overview.counts.orders}} orders in total.</p>
  {{#if section_data.available}}
  <p class="section-status section-status-ok">Order data is available from its owning module.</p>
  {{else}}
  <p class="empty-note">Order details are not connected yet{{#if section_data.reason}} &mdash; {{section_data.reason}}{{/if}}. The orders API stays the source of truth until the owning module answers the dashboard section hook.</p>
  {{/if}}
</section>
{{/if}}

{{#if section_school_fees}}
<section class="admin-section section-panel" data-section="school-fees" aria-labelledby="admin-fees-page-heading">
  <h1 id="admin-fees-page-heading">School Fees</h1>
  <p class="page-intro">School fee records for all students.</p>
  {{#if section_data.available}}
  <p class="section-status section-status-ok">School fee data is available from its owning module.</p>
  {{else}}
  <p class="empty-note">School fee details are not connected yet{{#if section_data.reason}} &mdash; {{section_data.reason}}{{/if}}.</p>
  {{/if}}
</section>
{{/if}}

{{#if section_servers}}
<section class="admin-section section-panel" data-section="servers" aria-labelledby="admin-servers-page-heading">
  <h1 id="admin-servers-page-heading">Servers &amp; Clusters</h1>
  <p class="page-intro">Servers and clusters are provided by their owning modules through the dashboard section hook.</p>
  {{#if section_data.available}}
  <p class="section-status section-status-ok">Server data is available from its owning module.</p>
  {{else}}
  <p class="empty-note">Server details are not connected yet{{#if section_data.reason}} &mdash; {{section_data.reason}}{{/if}}.</p>
  {{/if}}
</section>
{{/if}}

{{#if section_security}}
<section class="admin-section section-panel" data-section="security" aria-labelledby="admin-security-page-heading">
  <h1 id="admin-security-page-heading">Security</h1>
  <p class="page-intro">Security posture, from the module that owns it.</p>
  {{#if section_data.available}}
  <p class="section-status section-status-ok">Security data is available from its owning module.</p>
  {{else}}
  <p class="empty-note">Security details are not connected yet{{#if section_data.reason}} &mdash; {{section_data.reason}}{{/if}}.</p>
  {{/if}}
</section>
{{/if}}

{{#if section_logs}}
<section class="admin-section section-panel" data-section="logs" aria-labelledby="admin-logs-page-heading">
  <h1 id="admin-logs-page-heading">Logs</h1>
  <p class="page-intro">System logs, from the module that owns them.</p>
  {{#if section_data.available}}
  <p class="section-status section-status-ok">Log data is available from its owning module.</p>
  {{else}}
  <p class="empty-note">Log details are not connected yet{{#if section_data.reason}} &mdash; {{section_data.reason}}{{/if}}.</p>
  {{/if}}
</section>
{{/if}}
